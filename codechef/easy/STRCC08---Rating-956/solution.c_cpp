#include <stdio.h>
#include <string.h>

int main() {
    int t;
    scanf("%d", &t);

    while (t--) {
        char S[10001];
        scanf("%s", S);

        // your code here
       int count = 0;
        int happy = 0;

        for (int i = 0; S[i] != '\0'; i++) {

            if (S[i] == 'a' || S[i] == 'e' || S[i] == 'i' ||
                S[i] == 'o' || S[i] == 'u') {

                count++;

                if (count >= 3) {
                    happy = 1;
                    break;
                }

            } else {
                count = 0;
            }
        }

        if (happy)
            printf("HAPPY\n");
        else
            printf("SAD\n");
    }
    
    return 0;
}