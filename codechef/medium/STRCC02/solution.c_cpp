#include <stdio.h>
#include <string.h>

int main() 
{
  int t;
  scanf("%d", &t); 
  while(t--)
  {
   char S[100], A[100], B[100];
   scanf("%s", S);
// Write the code below this line to generate String A
for (int i = 0; i < strlen(S); i++) 
        {
            A[i] = S[i];
        }
        A[strlen(S)] = '\0';

// Write the code below this line to generate String A
   for (int i = strlen(S) - 1, j = 0; i >= 0; i--, j++)
        {
            B[j] = S[i];
        }
        B[strlen(S)] = '\0';

  for(int i=0; i<strlen(S);i++)
       {
         printf("%c",A[i]);
       }
   printf("\n");
   for(int i=0; i<strlen(S);i++)
       {
         printf("%c",B[i]);
       }
   printf("\n");
  }
 return 0;
}